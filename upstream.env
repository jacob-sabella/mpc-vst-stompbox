# The upstream DSP this plugin hosts. None of it is in this repo: tools/fetch-upstream.sh clones these exact commits into
# build/upstream/ at build time (git checks each commit by its hash; GxPlugins' superproject commit pins every pedal's
# submodule commit too). The Upstream workflow (tools/upstream-check.sh) opens a pull request that moves them forward.
GUITARIX_REPO=brummer10/guitarix
GUITARIX_COMMIT=666b564bb8a7194f200029fdbfbec2abe035f777
GXPLUGINS_REPO=brummer10/GxPlugins.lv2
GXPLUGINS_COMMIT=19df03e5e1be1a97bf3c60c66a0d3f830c0f35b9
# Eigen (header-only linear algebra) for guitarix's circuit-simulated preamp (plugins/jcm800pre.cpp): its 3.4.0 tag,
# not followed by the weekly check
EIGEN_URL=https://gitlab.com/libeigen/eigen
EIGEN_COMMIT=3147391d946bb4b6c68edd901f2add6ac1f31f8c
