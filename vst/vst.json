{
  "name": "Stompbox",
  "vendor": "jacob-sabella",
  "uid": "StBx",
  "version": 100,
  "so": "stompbox.so",
  "effect": true,
  "targets": [
    "armv7",
    "aarch64"
  ],
  "build": {
    "sources": [
      "src/rack.cpp",
      "src/host.cpp",
      "src/builtins.cpp"
    ],
    "cflags": [
      "-Isrc",
      "-std=gnu++17",
      "-Wno-unused-variable",
      "-Wno-unused-but-set-variable",
      "-Wno-sign-compare",
      "-Wno-unused-function",
      "-Wno-misleading-indentation",
      "-Wno-maybe-uninitialized"
    ],
    "libs": [
      "-lm",
      "-lpthread"
    ],
    "cflags_arm": [
      "-mfpu=neon-vfpv4"
    ]
  },
  "defines": {
    "HAS_DISPLAY_REV": 1,
    "PARAM_TEXT_MAX": 64
  },
  "sample_page": {
    "dial": "preset",
    "banks": [
      {
        "name": "AMP",
        "knobs": [
          "amp_k1",
          "amp_k2",
          "amp_k3"
        ]
      },
      {
        "name": "TONE",
        "knobs": [
          "tone_k1",
          "tone_k2",
          "tone_k3"
        ]
      },
      {
        "name": "LEVEL",
        "knobs": [
          "input",
          "output",
          "gate_k1"
        ]
      },
      {
        "name": "DELAY",
        "knobs": [
          "delay_k1",
          "delay_k2",
          "delay_k3"
        ]
      },
      {
        "name": "REVERB",
        "knobs": [
          "reverb_k1",
          "reverb_k2",
          "reverb_k3"
        ]
      }
    ],
    "lines": [
      {
        "key": "amp_model",
        "label": true
      },
      {
        "key": "tone_model",
        "label": true
      },
      {
        "key": "cab_model",
        "label": true
      },
      {
        "key": "delay_model",
        "label": true
      },
      {
        "key": "reverb_model",
        "label": true
      }
    ],
    "fps": 12
  }
}
